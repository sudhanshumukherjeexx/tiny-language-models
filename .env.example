# Copy to .env (git-ignored) and fill in only what you use. Nothing here is
# required for training, evaluation or tests.

# Optional LLM judge (scripts/evaluate.py --judge anthropic; `uv sync --extra judge`)
ANTHROPIC_API_KEY=

# Optional: higher Hugging Face Hub rate limits, and uploading the model
HF_TOKEN=

# Optional: where the Gradio demo loads the model from (local dir or Hub id)
TINYLM_MODEL=runs/tiny-27m/best
